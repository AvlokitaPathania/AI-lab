class Node:
    def __init__(self, state, depth=0, parent=None):
        self.state = state
        self.depth = depth
        self.parent = parent

def find_blank(state):
    """Finds row, col of the blank tile (0)."""
    for r in range(3):
        for c in range(3):
            if state[r][c] == 0:
                return r, c

def get_neighbors(state):
    """Generates valid adjacent states by moving the blank tile."""
    r, c = find_blank(state)
    neighbors = []
    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # Up, Down, Left, Right
    
    for dr, dc in moves:
        nr, nc = r + dr, c + dc
        if 0 <= nr < 3 and 0 <= nc < 3:
            new_state = [list(row) for row in state]
            new_state[r][c], new_state[nr][nc] = new_state[nr][nc], new_state[r][c]
            neighbors.append(tuple(tuple(row) for row in new_state))
            
    return neighbors

def reconstruct_path(node):
    path = []
    curr = node
    while curr:
        path.append(curr.state)
        curr = curr.parent
    return path[::-1]

def depth_limited_dfs(node, goal_tuple, limit, visited_path):
    if node.state == goal_tuple:
        return reconstruct_path(node)
    
    if node.depth == limit:
        return "CUTOFF"
    
    cutoff_occurred = False

    for nxt in get_neighbors(node.state):
        # Prevent cycles on the current depth path
        if nxt not in visited_path:
            visited_path.add(nxt)
            child_node = Node(nxt, depth=node.depth + 1, parent=node)
            
            result = depth_limited_dfs(child_node, goal_tuple, limit, visited_path)
            visited_path.remove(nxt)  # Backtrack

            if result == "CUTOFF":
                cutoff_occurred = True
            elif result is not None:
                return result  # Goal found!

    return "CUTOFF" if cutoff_occurred else None

def ids_8puzzle(start, goal):
    start_tuple = tuple(tuple(row) for row in start)
    goal_tuple = tuple(tuple(row) for row in goal)
    
    depth_limit = 0
    while True:
        print(f"Testing Depth Limit = {depth_limit}...")
        root = Node(start_tuple, depth=0)
        visited_path = {start_tuple}
        
        result = depth_limited_dfs(root, goal_tuple, depth_limit, visited_path)
        
        if result != "CUTOFF":
            return result
        
        depth_limit += 1

