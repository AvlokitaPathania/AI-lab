facts = {
    ("American", "Robert"),
    ("Enemy", "A", "America"),
    ("Owns", "A", "T1"),
    ("Missile", "T1")
}

# Store the rule and premises used to derive each fact
proof = {}

# 2. Define Inference Rules
rules = [
    {
        "name": "R1",
        "premises": [("Missile", "?x")],
        "conclusion": ("Weapon", "?x")
    },
    {
        "name": "R2",
        "premises": [
            ("Missile", "?x"),
            ("Owns", "A", "?x")
        ],
        "conclusion": ("Sells", "Robert", "?x", "A")
    },
    {
        "name": "R3",
        "premises": [("Enemy", "?x", "America")],
        "conclusion": ("Hostile", "?x")
    },
    {
        "name": "R4",
        "premises": [
            ("American", "?p"),
            ("Weapon", "?q"),
            ("Sells", "?p", "?q", "?r"),
            ("Hostile", "?r")
        ],
        "conclusion": ("Criminal", "?p")
    }
]


# 3. Convert tuple into readable format
def format_fact(fact):
    predicate = fact[0]
    arguments = ", ".join(fact[1:])
    return predicate + "(" + arguments + ")"


# 4. Match rule patterns with existing facts
def match(pattern, fact, substitution=None):

    if substitution is None:
        substitution = {}

    if pattern[0] != fact[0] or len(pattern) != len(fact):
        return None

    substitution = substitution.copy()

    for p, f in zip(pattern[1:], fact[1:]):

        if p.startswith("?"):

            if p in substitution:
                if substitution[p] != f:
                    return None
            else:
                substitution[p] = f

        elif p != f:
            return None

    return substitution


# 5. Find all possible matches for rule premises
def find_matches(premises, current_facts):

    results = []

    def search(index, substitution, used_facts):

        if index == len(premises):
            results.append((substitution, used_facts))
            return

        pattern = premises[index]

        for fact in sorted(current_facts):

            new_sub = match(pattern, fact, substitution)

            if new_sub is not None:
                search(
                    index + 1,
                    new_sub,
                    used_facts + [fact]
                )

    search(0, {}, [])
    return results


# 6. Forward Chaining Algorithm
def forward_chaining():

    iteration = 1

    while True:

        new_facts = []

        print("\nIteration", iteration)

        for rule in rules:

            matches = find_matches(
                rule["premises"],
                facts
            )

            for substitution, used_facts in matches:

                conclusion = tuple(
                    substitution.get(item, item)
                    if item.startswith("?") else item
                    for item in rule["conclusion"]
                )

                if conclusion not in facts and conclusion not in new_facts:

                    new_facts.append(conclusion)

                    proof[conclusion] = (
                        rule["name"],
                        used_facts
                    )

                    print(
                        rule["name"],
                        "derived:",
                        format_fact(conclusion)
                    )

        # Stop when no new facts can be generated
        if not new_facts:
            print("No new facts can be derived.")
            break

        facts.update(new_facts)
        iteration += 1


# 7. Display Proper Proof Tree
def display_proof(goal, prefix="", is_last=True, is_root=True):

    # Print the correct tree branch
    if is_root:
        connector = ""
    else:
        connector = "└── " if is_last else "├── "

    # Print the current fact
    print(prefix + connector + format_fact(goal), end="")

    # Check whether it is an initial fact or derived fact
    if goal in proof:

        rule, premises = proof[goal]
        print("  [Derived using " + rule + "]")

        # Prepare indentation for child nodes
        if is_root:
            child_prefix = prefix
        else:
            child_prefix = prefix + ("    " if is_last else "│   ")

        # Recursively display all premises
        for i, premise in enumerate(premises):

            display_proof(
                premise,
                child_prefix,
                i == len(premises) - 1,
                False
            )

    else:
        print("  [Initial Fact]")


# 8. Main Program
print("======================================")
print("   FIRST ORDER LOGIC - FORWARD CHAINING")
print("======================================")

print("\nINITIAL KNOWLEDGE BASE:")

for fact in sorted(facts):
    print(format_fact(fact))

# Execute forward chaining
forward_chaining()

# Define the goal
goal = ("Criminal", "Robert")

print("\n======================================")
print("FINAL RESULT")
print("======================================")

if goal in facts:

    print("Goal proved:", format_fact(goal))

    print("\nFORWARD CHAINING PROOF TREE:")
    display_proof(goal)

else:
    print("Goal cannot be proved.")
